{
  "id": "davideo",
  "name": "Da-Video",
  "version": "0.5.0",
  "apiVersion": 31,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Todos tus plugins de video en uno: busca en los que tienes, instala los que faltan, configúralos y mantenlos al día solos.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-davideo",
  "hosts": [
    "raw.githubusercontent.com"
  ],
  "capabilities": [
    "screen",
    "schedule",
    "manage",
    "library",
    "notifications"
  ],
  "screen": {
    "label": "Da-Video",
    "labelEn": "Da-Video",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir Da-Video",
      "labelEn": "Open Da-Video"
    }
  },
  "jobs": [
    {
      "id": "update",
      "label": {
        "es": "Actualizar mis plugins",
        "en": "Update my plugins"
      },
      "everyMin": 240,
      "everyOptions": [
        240,
        300,
        360
      ]
    },
    {
      "id": "episodes",
      "label": {
        "es": "Avisarme de capítulos nuevos",
        "en": "Tell me about new episodes"
      },
      "everyMin": 360,
      "everyOptions": [
        180,
        360,
        720
      ]
    }
  ],
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "bundles": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "mine": {
      "author": "xuper-plugin",
      "door": "catalog",
      "calls": [
        "search",
        "episodes"
      ]
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
